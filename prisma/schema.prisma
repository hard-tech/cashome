// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int            @id @default(autoincrement())
  username            String         @unique
  password            String
  firstName           String
  lastName            String
  role                Role           @default(MEMBER)
  balance             Float          @default(0)
  household           Household      @relation(fields: [householdId], references: [id])
  householdId         Int
  
  // Items relations
  listedItems         Item[]         @relation("SellerItems")
  purchasedItems      ItemPurchase[] @relation("BuyerPurchases")
  
  // Missions relations
  createdMissions     Mission[]      @relation("CreatedMissions")
  assignedMissions    Mission[]      @relation("AssignedMissions")
  
  // Transactions relations
  sentTransactions    Transaction[]  @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")
  
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([householdId])
}

model Household {
  id        Int      @id @default(autoincrement())
  name      String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mission {
  id          Int           @id @default(autoincrement())
  title       String
  description String
  reward      Float
  deadline    DateTime
  status      MissionStatus @default(OPEN)
  
  creator     User          @relation("CreatedMissions", fields: [creatorId], references: [id])
  creatorId   Int
  assignee    User?         @relation("AssignedMissions", fields: [assigneeId], references: [id])
  assigneeId  Int?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([creatorId])
  @@index([assigneeId])
}

model Item {
  id          Int            @id @default(autoincrement())
  name        String
  description String
  price       Float
  quantity    Int            @default(1)
  status      ItemStatus     @default(AVAILABLE)
  
  seller      User           @relation("SellerItems", fields: [sellerId], references: [id])
  sellerId    Int
  purchases   ItemPurchase[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([sellerId])
}

model ItemPurchase {
  id         Int            @id @default(autoincrement())
  quantity   Int
  totalPrice Float
  status     PurchaseStatus @default(PENDING)
  
  item       Item           @relation(fields: [itemId], references: [id])
  itemId     Int
  buyer      User           @relation("BuyerPurchases", fields: [buyerId], references: [id])
  buyerId    Int
  
  transaction Transaction?  // Relation optionnelle avec la transaction associée
  
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([itemId])
  @@index([buyerId])
}

model Transaction {
  id          Int               @id @default(autoincrement())
  amount      Float
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  description String?
  
  sender      User              @relation("SentTransactions", fields: [senderId], references: [id])
  senderId    Int
  receiver    User              @relation("ReceivedTransactions", fields: [receiverId], references: [id])
  receiverId  Int
  
  itemPurchase ItemPurchase?    @relation(fields: [itemPurchaseId], references: [id])
  itemPurchaseId Int?           @unique // Une transaction ne peut être liée qu'à un seul achat
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([itemPurchaseId])
}



enum MissionStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum Role {
  MEMBER
  BANK
  ADMIN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SALE
  PURCHASE
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ItemStatus {
  AVAILABLE
  SOLD_OUT
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}
