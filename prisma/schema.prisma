// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  username         String   @unique
  password         String
  firstName        String
  lastName         String
  role             Role     @default(MEMBER)
  balance          Float    @default(0)
  household        Household @relation(fields: [householdId], references: [id])
  householdId      Int
  items            Item[]
  createdMissions  Mission[] @relation("CreatedMissions")
  assignedMissions Mission[] @relation("AssignedMissions")
  transactions     Transaction[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


model Mission {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  reward      Float
  deadline    DateTime
  creator     User     @relation("CreatedMissions", fields: [creatorId], references: [id])
  creatorId   Int
  assignee    User?    @relation("AssignedMissions", fields: [assigneeId], references: [id])
  assigneeId  Int?
  status      MissionStatus @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Household {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model Item {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  price       Float
  seller      User   @relation(fields: [sellerId], references: [id])
  sellerId    Int
}


model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Float
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
}

enum MissionStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum Role {
  MEMBER
  BANK
  ADMIN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}
